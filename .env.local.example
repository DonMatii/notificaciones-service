# Copia este archivo a .env.local y completa con tus valores reales.
# .env.local esta gitignored: nunca se commitea.

# SMTP de Gmail (contrasena de aplicacion: myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=PEGA_AQUI_TU_CORREO
MAIL_PASS=PEGA_AQUI_LA_CONTRASENA_DE_APLICACION
MAIL_FROM=PEGA_AQUI_TU_CORREO

# API key administrativa (RNF-11): sin ella los endpoints protegidos responden 503.
# Debe ser la MISMA que VITE_ADMIN_API_KEY del frontend (pasteleria-my-dreams-react/.env.development).
APP_ADMIN_API_KEY=PEGA_AQUI_EL_MISMO_VALOR_DE_VITE_ADMIN_API_KEY
